<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Amiasea.Enterprise.Data.Migration.Design</PackageId>
    <Version>1.0.0</Version>
    <PackageOutputPath>$(MSBuildProjectDirectory)/../../packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"
                      Version="11.0.0-rc.1.26425.128">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="build/Amiasea.Enterprise.Data.Migration.Design.props"
          Pack="true"
          PackagePath="build/Amiasea.Enterprise.Data.Migration.Design.props" />
  </ItemGroup>

</Project>